# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.6-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Creatomate server-side API key used for MP4 rendering.
CREATOMATE_API_KEY="YOUR_CREATOMATE_API_KEY"
# Jamendo developer client ID for automatic instrumental music search.
JAMENDO_CLIENT_ID="YOUR_JAMENDO_CLIENT_ID"
# Optional public/licensed MP3 URL. Defaults to Creatomate's demo music.
CREATOMATE_MUSIC_URL="https://your-public-domain-audio-url/music.mp3"
# Optional image-to-video and voice provider keys.
RUNWAY_API_KEY="YOUR_RUNWAY_API_KEY"
ELEVENLABS_API_KEY="YOUR_ELEVENLABS_API_KEY"

# Optional: Real Social Media OAuth & API Credentials for Account Connection
# Meta (Instagram & Facebook Reels)
META_CLIENT_ID=""
META_CLIENT_SECRET=""

# TikTok (Content Posting API v2)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# YouTube / Google OAuth 2.0 (YouTube Data API v3)
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""

# Twitter / X (API v2 Media & OAuth 2.0)
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# Snapchat (Marketing & Spotlight API)
SNAPCHAT_CLIENT_ID=""
SNAPCHAT_CLIENT_SECRET=""
